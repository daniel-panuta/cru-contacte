# Backend environment template
# Copy to backend/.env.backend and fill with your own values.

# Required: PostgreSQL/Neon connection URL
DATABASE_URL="postgresql+psycopg2://user:password@host:5432/database?sslmode=require"

# Required: strong JWT secret key
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace-with-strong-random-secret"

# Optional auth settings
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required for first admin bootstrap
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-strong-admin-password"
ADMIN_NAME="System Admin"
